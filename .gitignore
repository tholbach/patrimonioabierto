# Raw intermediate pulls from JCyL's WFS - large (multi-MB) and fully
# reproducible via scripts/fetch_jcyl.py, no reason to version them.
data/raw/

scratchpad/

# Caddy's access log, bind-mounted from the container (docker-compose.yml).
# The host's own logs, not repo content - and even masked (see the
# Caddyfile's ip_mask filter), visitor request data has no business in a
# public git history.
logs/

__pycache__/
*.pyc

# Host-specific deployment settings (currently just the name of the
# external Docker network the ingress proxy is on). Names private
# infrastructure and differs per host, so it stays out of the repo -
# .env.example is the committed template.
.env
